<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="1dp"
    style="@style/InstagramCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/instagram_white">

        <!-- User info header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imageViewUserAvatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_profile_outline"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_background"
                android:contentDescription="Avatar do usuário" />

            <TextView
                android:id="@+id/textViewUserName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Nome do usuário"
                android:textSize="14sp"
                android:textColor="@color/instagram_gray_text"
                android:fontFamily="sans-serif-medium"
                tools:text="maria_silva" />

            <Button
                android:id="@+id/buttonFollow"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Seguir"
                android:textSize="12sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                style="@style/InstagramButtonSecondary" />

        </LinearLayout>

        <!-- Animal info section - MOVIDO PARA CIMA DA FOTO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <!-- Nome do animal -->
            <TextView
                android:id="@+id/textViewNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome do Pet"
                android:textSize="16sp"
                android:textColor="@color/instagram_gray_text"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="4dp"
                tools:text="Max" />

            <!-- Descrição do animal -->
            <TextView
                android:id="@+id/textViewDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descrição do animal"
                android:textSize="14sp"
                android:textColor="@color/instagram_gray_text"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Um lindo golden retriever de 2 anos, muito carinhoso e brincalhão. Procura uma família amorosa!" />

        </LinearLayout>

        <!-- Imagem do animal -->
        <ImageView
            android:id="@+id/imageViewAnimal"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:contentDescription="Imagem do animal"
            tools:src="@drawable/placeholder_pet" />

        <!-- Ações do post -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/buttonLike"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_heart_outline"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="Curtir" />

            <ImageView
                android:id="@+id/buttonComment"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_comment_outline"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="Comentar" />

            <ImageView
                android:id="@+id/btnShare"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_share_outline"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:contentDescription="Compartilhar" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/buttonTenhoInteresse"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Tenho interesse"
                android:textSize="12sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                style="@style/InstagramButtonPrimary" />

        </LinearLayout>

        <!-- Número de curtidas -->
        <TextView
            android:id="@+id/textViewLikes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:text="0 curtidas"
            android:textSize="14sp"
            android:textColor="@color/instagram_gray_text"
            android:fontFamily="sans-serif-medium"
            tools:text="127 curtidas" />

        <!-- SEÇÃO DE COMENTÁRIOS REMOVIDA COMPLETAMENTE -->
        <!-- Elementos necessários para o AnimalAdapter (invisíveis) -->
        <LinearLayout
            android:id="@+id/layoutComentarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewComentarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <EditText
                android:id="@+id/editComentario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Adicione um comentário..."
                android:textSize="14sp"
                android:background="@null"
                android:padding="8dp"
                android:maxLines="3" />

            <Button
                android:id="@+id/buttonEnviarComentario"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Enviar"
                android:textSize="12sp"
                style="@style/InstagramButtonPrimary" />

            <!-- Elementos invisíveis necessários para o AnimalAdapter -->
            <TextView
                android:id="@+id/textViewIdade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textViewSexo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textViewPorte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
