<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/imageViewUserAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/default_profile"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_background"
                android:contentDescription="Avatar do usuário" />

            <TextView
                android:id="@+id/textViewUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Nome do Usuário"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000" />

        </LinearLayout>

        <!-- Imagem do post: largura total, altura igual à largura para formato quadrado -->
        <ImageView
            android:id="@+id/imageViewAnimal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:contentDescription="Imagem do animal"
            android:maxHeight="400dp"
            android:minHeight="300dp" />

        <!-- Barra de ações -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/buttonLike"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Curtir"
                android:src="@drawable/unlike"
                app:tint="@color/like_color" />

            <ImageButton
                android:id="@+id/buttonComment"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Comentar"
                android:src="@drawable/outline_add_comment_24"
                app:tint="@color/comment_color" />

            <ImageButton
                android:id="@+id/buttonShare"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Compartilhar"
                android:src="@drawable/ic_share"
                app:tint="@color/share_color" />
        </LinearLayout>

        <!-- Likes -->
        <TextView
            android:id="@+id/textViewLikes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 curtidas"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:paddingStart="12dp"
            android:paddingTop="4dp" />

        <!-- Comentários -->
        <TextView
            android:id="@+id/textComentarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 comentários"
            android:textSize="14sp"
            android:textColor="#000000"
            android:paddingStart="12dp"
            android:paddingTop="2dp" />

        <!-- Nome do animal + descrição -->
        <TextView
            android:id="@+id/textViewNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome do Animal"
            android:textSize="14sp"
            android:textColor="#000000"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <!-- Comentários e envio (oculto por padrão) -->
        <LinearLayout
            android:id="@+id/layoutComentarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewComentarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <EditText
                android:id="@+id/editComentario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Adicione um comentário..."
                android:inputType="text"
                android:maxLines="3"
                android:background="@drawable/edittext_background"
                android:padding="8dp"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/buttonEnviarComentario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Publicar"
                android:layout_gravity="end"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
