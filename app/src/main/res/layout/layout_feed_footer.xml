<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/instagram_white">

    <!-- Action buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnLike"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_heart_outline"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="Curtir" />

        <ImageView
            android:id="@+id/btnComment"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_comment_outline"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="Comentar" />

        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_share_outline"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:contentDescription="Compartilhar" />

    </LinearLayout>

    <!-- Likes count -->
    <TextView
        android:id="@+id/textViewLikes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:text="0 curtidas"
        android:textSize="14sp"
        android:textColor="@color/instagram_gray_text"
        android:fontFamily="sans-serif-medium"
        tools:text="127 curtidas" />

    <!-- Comments preview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/textViewUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="username"
            android:textSize="14sp"
            android:textColor="@color/instagram_gray_text"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="8dp"
            tools:text="joao_silva" />

        <TextView
            android:id="@+id/textViewCaption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Caption do post"
            android:textSize="14sp"
            android:textColor="@color/instagram_gray_text"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Que lindo esse golden retriever! 🐕" />

    </LinearLayout>

    <!-- Timestamp -->
    <TextView
        android:id="@+id/textViewTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:text="há 2 horas"
        android:textSize="12sp"
        android:textColor="@color/instagram_gray_dark"
        android:fontFamily="sans-serif"
        tools:text="há 2 horas" />

</LinearLayout>
