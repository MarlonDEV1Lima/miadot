<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fundo com degradê -->
    <View
        android:id="@+id/backgroundGradient"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Títulos -->
    <TextView
        android:id="@+id/tvHello"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Faça seu"
        android:textColor="@android:color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="60dp"
        android:layout_marginStart="24dp" />

    <TextView
        android:id="@+id/tvSignIn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cadastro"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        app:layout_constraintTop_toBottomOf="@id/tvHello"
        app:layout_constraintStart_toStartOf="@id/tvHello"
        android:layout_marginTop="4dp" />

    <!-- Card branco arredondado -->
    <androidx.cardview.widget.CardView
        android:id="@+id/loginCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvSignIn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Email -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textColor="#C62828"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/editTextRegisterEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="example@gmail.com"
                    android:inputType="textEmailAddress"
                    android:background="@android:color/transparent"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="16dp" />

                <!-- Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Senha"
                    android:textColor="#C62828"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editTextRegisterPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="********"
                    android:inputType="textPassword"
                    android:background="@android:color/transparent"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="8dp" />

                <!-- CEP -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CEP"
                    android:textColor="#C62828"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/editTextRegisterCep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="00000-000"
                    android:inputType="number"
                    android:maxLength="9"
                    android:background="@android:color/transparent"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="16dp" />

                <!-- Rua -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rua"
                    android:textColor="#C62828"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editTextRegisterStreet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Rua"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="16dp" />

                <!-- Bairro -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bairro"
                    android:textColor="#C62828"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editTextRegisterNeighborhood"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Bairro"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="16dp" />

                <!-- Cidade -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cidade"
                    android:textColor="#C62828"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editTextRegisterCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Cidade"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="16dp" />

                <!-- Estado -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado"
                    android:textColor="#C62828"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editTextRegisterState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Estado"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:paddingBottom="8dp"
                    android:layout_marginBottom="16dp" />

                <!-- Botão -->
                <Button
                    android:id="@+id/buttonRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cadastrar"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_button"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>

        </ScrollView>

    </androidx.cardview.widget.CardView>

    <!-- View branca na frente do CardView para tapar degradê na parte inferior -->
    <View
        android:id="@+id/whiteOverlay"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@android:color/white"
        android:elevation="16dp"
        android:outlineProvider="none"
        app:layout_constraintBottom_toBottomOf="@id/loginCard"
        app:layout_constraintStart_toStartOf="@id/loginCard"
        app:layout_constraintEnd_toEndOf="@id/loginCard" />

</androidx.constraintlayout.widget.ConstraintLayout>
