<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/instagram_gray_light" />
            <stroke android:width="1dp" android:color="@color/instagram_gray_dark" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/instagram_white" />
            <stroke android:width="1dp" android:color="@color/instagram_gray_medium" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>

